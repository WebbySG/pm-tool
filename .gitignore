# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — all variants blocked
.env
.env.*
# allow the example template (contains only placeholders, no real secrets)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# One-off backup written by scripts/migrate-base64-descriptions.mjs
scripts/base64-descriptions-backup.json

# Generated/downloaded invoice + quote PDFs. These contain client billing data
# and must never enter git history — financials are owner-only (see CLAUDE.md,
# "Owner-Only Financial Data"). Keep them out of the repo and off the VPS.
WSG-*.pdf
WSGQ-*.pdf
*-invoice.pdf

# Local agent/tool scratch config
.codex/
